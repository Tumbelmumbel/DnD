# .htaccess – protects files that must never be downloaded from the website.
# Do not remove this file. The deploy uploads it with every merge.

# 0) The start page is index.php (it sends the visitor to the sign-in page)
DirectoryIndex index.php

# 1) Files whose name starts with a dot: .env, .env.example, .gitignore, ...
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 2) Logs, PHP settings, database scripts, documentation and example files
<FilesMatch "\.(log|ini|sql|md|example)$">
    Require all denied
</FilesMatch>

# 3) migrate.php runs only from the command line (deploy). It must never run from the web.
<Files "migrate.php">
    Require all denied
</Files>
